{
  "name": "traderx",
  "displayName": "TraderX A股自选",
  "description": "A股自选行情、主力净流入与持仓盈亏（本地）",
  "version": "0.4.19",
  "publisher": "traderx",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:traderx.watchlistView",
    "onView:traderx.watchlistView.panel",
    "onView:traderx.marketNavigator",
    "onView:traderx.marketNavigator.panel",
    "onView:traderx.dividendView",
    "onView:traderx.dividendView.panel",
    "onCommand:traderx.openMarket",
    "onCommand:traderx.market.openPage",
    "onCommand:traderx.addStock",
    "onCommand:traderx.removeStock",
    "onCommand:traderx.editPosition",
    "onCommand:traderx.refreshQuotes",
    "onCommand:traderx.createGroup",
    "onCommand:traderx.renameGroup",
    "onCommand:traderx.deleteGroup",
    "onCommand:traderx.openIntraday",
    "onCommand:traderx.openIntradayPickPlatform",
    "onCommand:traderx.openGroupManage",
    "onCommand:traderx.openSettings",
    "onCommand:traderx.openTraderxPanel",
    "onCommand:traderx.backToEditor",
    "onCommand:traderx.openExplorerView",
    "onCommand:traderx.dividend.addStock",
    "onCommand:traderx.dividend.removeStock",
    "onCommand:traderx.dividend.refresh",
    "onCommand:traderx.dividend.openDetail",
    "onCommand:traderx.dividend.editHolding"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "traderx",
          "title": "TraderX",
          "icon": "media/chart.svg"
        }
      ],
      "panel": [
        {
          "id": "traderx-panel",
          "title": "TraderX",
          "icon": "media/chart.svg"
        }
      ]
    },
    "views": {
      "traderx": [
        {
          "type": "webview",
          "id": "traderx.watchlistView",
          "name": "自选"
        },
        {
          "type": "webview",
          "id": "traderx.dividendView",
          "name": "股息"
        },
        {
          "id": "traderx.marketNavigator",
          "name": "市场行情"
        }
      ],
      "traderx-panel": [
        {
          "type": "webview",
          "id": "traderx.watchlistView.panel",
          "name": "自选"
        },
        {
          "type": "webview",
          "id": "traderx.dividendView.panel",
          "name": "股息"
        },
        {
          "id": "traderx.marketNavigator.panel",
          "name": "市场行情"
        }
      ]
    },
    "commands": [
      {
        "command": "traderx.addStock",
        "title": "TraderX: 添加自选"
      },
      {
        "command": "traderx.removeStock",
        "title": "TraderX: 从当前分组删除自选"
      },
      {
        "command": "traderx.editPosition",
        "title": "TraderX: 编辑成本与持仓"
      },
      {
        "command": "traderx.refreshQuotes",
        "title": "TraderX: 刷新行情"
      },
      {
        "command": "traderx.createGroup",
        "title": "TraderX: 新建分组"
      },
      {
        "command": "traderx.renameGroup",
        "title": "TraderX: 重命名分组"
      },
      {
        "command": "traderx.deleteGroup",
        "title": "TraderX: 删除分组"
      },
      {
        "command": "traderx.openIntraday",
        "title": "TraderX: 打开分时行情"
      },
      {
        "command": "traderx.openIntradayPickPlatform",
        "title": "TraderX: 选择站点打开分时"
      },
      {
        "command": "traderx.openGroupManage",
        "title": "TraderX: 分组管理"
      },
      {
        "command": "traderx.openSettings",
        "title": "TraderX: 全局设置"
      },
      {
        "command": "traderx.openMarket",
        "title": "TraderX: 打开市场行情"
      },
      {
        "command": "traderx.market.openPage",
        "title": "TraderX: 打开市场行情子页"
      },
      {
        "command": "traderx.openTraderxPanel",
        "title": "TraderX: 打开底部面板视图（与终端同区，可拖动停靠）"
      },
      {
        "command": "traderx.backToEditor",
        "title": "TraderX: 回到编辑区（离开侧栏/面板）"
      },
      {
        "command": "traderx.openExplorerView",
        "title": "TraderX: 切换到资源管理器"
      },
      {
        "command": "traderx.dividend.addStock",
        "title": "TraderX: 添加股息关注"
      },
      {
        "command": "traderx.dividend.removeStock",
        "title": "TraderX: 从股息关注移除"
      },
      {
        "command": "traderx.dividend.refresh",
        "title": "TraderX: 刷新股息数据"
      },
      {
        "command": "traderx.dividend.openDetail",
        "title": "TraderX: 查看股息详情"
      },
      {
        "command": "traderx.dividend.editHolding",
        "title": "TraderX: 编辑股息估算用持仓"
      }
    ],
    "keybindings": [
      {
        "command": "traderx.backToEditor",
        "key": "ctrl+shift+;",
        "mac": "cmd+shift+;"
      }
    ],
    "configuration": {
      "title": "TraderX",
      "properties": {
        "traderx.refreshIntervalSeconds": {
          "type": "number",
          "default": 3,
          "minimum": 3,
          "maximum": 300,
          "description": "自动刷新行情间隔（秒）"
        },
        "traderx.quoteProviderOrder": {
          "type": "array",
          "default": [
            "sina",
            "tencent"
          ],
          "items": {
            "type": "string",
            "enum": [
              "sina",
              "tencent"
            ]
          },
          "description": "基础行情数据源优先级（前者优先，失败则尝试下一个）"
        },
        "traderx.turnoverDisplay": {
          "type": "string",
          "enum": [
            "wan",
            "yi"
          ],
          "default": "yi",
          "description": "成交额展示单位：万 / 亿（人民币）"
        },
        "traderx.intradayStealthMode": {
          "type": "boolean",
          "default": false,
          "description": "低调办公：页面更低调显示；分时固定打开低调分时页。开启后忽略分时查看方式与站点"
        },
        "traderx.intradayDisplayMode": {
          "type": "string",
          "enum": [
            "webviewCanvas",
            "simpleBrowser",
            "systemBrowser"
          ],
          "default": "webviewCanvas",
          "description": "分时查看方式：本地 Webview Canvas（跟随 VSCode 暗黑主题）、内置 Simple Browser 或系统浏览器"
        },
        "traderx.intradayPageProvider": {
          "type": "string",
          "enum": [
            "eastmoney_full",
            "eastmoney_discreet"
          ],
          "default": "eastmoney_full",
          "description": "行情页站点：东方财富完整行情（PC 个股页）或东方财富低调分时页。历史 eastmoney/sina/tencent 将映射为完整行情"
        },
        "traderx.marketFetchTimeoutMs": {
          "type": "number",
          "default": 15000,
          "minimum": 5000,
          "maximum": 120000,
          "description": "市场行情（全球股指/行业排行/资金流向）请求超时（毫秒）"
        },
        "traderx.dividend.refreshIntervalHours": {
          "type": "number",
          "default": 12,
          "minimum": 1,
          "maximum": 168,
          "description": "股息数据缓存有效期（小时）；超过则后台懒刷新，手动刷新可强制忽略缓存"
        },
        "traderx.dividend.yearAttribution": {
          "type": "string",
          "enum": [
            "payYear",
            "recordYear",
            "announceYear"
          ],
          "default": "payYear",
          "description": "股息年度归属口径：派息年 / 登记年 / 公告年（缺失时自动降级并标注）"
        },
        "traderx.dividend.showAfterTax": {
          "type": "boolean",
          "default": false,
          "description": "估算时显示税后近似值（非精确口径，仅作参考）"
        },
        "traderx.dividend.taxRate": {
          "type": "number",
          "default": 0.1,
          "minimum": 0,
          "maximum": 0.45,
          "description": "税后估算所用税率（仅当 showAfterTax 为 true 时生效）"
        },
        "traderx.dividend.providerOrder": {
          "type": "array",
          "default": [
            "eastmoney"
          ],
          "items": {
            "type": "string",
            "enum": [
              "eastmoney"
            ]
          },
          "description": "股息数据源优先级（预留多源扩展，当前仅 eastmoney）"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "release:vsix": "bash ./scripts/release-vsix.sh"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
